NEXT_PUBLIC_KEYCLOAK_URL=http://keycloak.localhost:8080

# -----------------------------
# AI Governance Control Plane Configuration
# -----------------------------
AI_GOVERNANCE_ENV=local
AI_GOVERNANCE_CORS_ALLOW_ORIGINS='http://localhost:3000,http://127.0.0.1:3000'
AI_GOVERNANCE_AUTO_SEED_DEMO_DATA=true
AI_GOVERNANCE_API_LOG_LEVEL=debug
AI_GOVERNANCE_API_HOST=localhost
AI_GOVERNANCE_API_PORT=8000

# -----------------------------
# IDP Configuration
# -----------------------------
AI_GOVERNANCE_AUTH_MODE=keycloak # development
AI_GOVERNANCE_DEVELOPMENT_ACTOR_ID=local-admin
AI_GOVERNANCE_DEVELOPMENT_ACTOR_NAME='Local Administrator'
AI_GOVERNANCE_OIDC_ISSUER=http://keycloak.localhost:18080/realms/ai-governance
AI_GOVERNANCE_OIDC_JWKS_REFRESH_SECONDS=300

# -----------------------------
# RBAC & Multi-Tenant Configuration
# -----------------------------
AI_GOVERNANCE_ALLOW_DEVELOPMENT_IDENTITY_IN_PRODUCTION=false
AI_GOVERNANCE_TENANCY_ENABLED=true

AI_GOVERNANCE_BOOTSTRAP_ORGANIZATION_ID=org_default
AI_GOVERNANCE_BOOTSTRAP_ORGANIZATION_NAME='Default Organization'
AI_GOVERNANCE_BOOTSTRAP_ORGANIZATION_SLUG=default
# Subject of the stable `studio` user in keycloak/ai-governance-realm.json.
# Required only by the host-local Keycloak API flow during tenancy bootstrap.
AI_GOVERNANCE_BOOTSTRAP_ADMIN_SUB=e44566f1-c748-45e1-83db-d2ee5fb424ef
AI_GOVERNANCE_BOOTSTRAP_ADMIN_NAME=studio
AI_GOVERNANCE_BOOTSTRAP_PROJECT_ID=project_default
AI_GOVERNANCE_BOOTSTRAP_PROJECT_NAME='Default Project'
AI_GOVERNANCE_BOOTSTRAP_PROJECT_SLUG=default

# -----------------------------
# Grpah DB Configuration
# -----------------------------
AI_GOVERNANCE_GRAPH_URI=bolt://localhost:7687
AI_GOVERNANCE_GRAPH_USER=neo4j
AI_GOVERNANCE_GRAPH_PASSWORD=ai-governance-local-password
AI_GOVERNANCE_ONTOLOGY_REPOSITORY=neo4j

# -----------------------------
# Repositories Configuration
# -----------------------------
# inmemory / sqlite / postgres
AI_GOVERNANCE_TENANCY_REPOSITORY=sqlite
AI_GOVERNANCE_TENANCY_SQLITE_PATH=./.ai-governance/governance.db
AI_GOVERNANCE_SETTINGS_REPOSITORY=sqlite
AI_GOVERNANCE_SETTINGS_SQLITE_PATH=./.ai-governance/governance.db
AI_GOVERNANCE_POLICY_REPOSITORY=sqlite
AI_GOVERNANCE_POLICY_SQLITE_PATH=./.ai-governance/governance.db
AI_GOVERNANCE_EVALUATION_REPOSITORY=sqlite
AI_GOVERNANCE_EVALUATION_SQLITE_PATH=./.ai-governance/governance.db
AI_GOVERNANCE_EXPERIMENT_REPOSITORY=sqlite
AI_GOVERNANCE_EXPERIMENT_SQLITE_PATH=./.ai-governance/governance.db
AI_GOVERNANCE_EXPERIMENT_CANDIDATE_REPOSITORY=sqlite
AI_GOVERNANCE_EXPERIMENT_CANDIDATE_SQLITE_PATH=./.ai-governance/governance.db
AI_GOVERNANCE_EVALUATION_RUN_REPOSITORY=sqlite
AI_GOVERNANCE_EVALUATION_RUN_SQLITE_PATH=./.ai-governance/governance.db
AI_GOVERNANCE_LEADERBOARD_REPOSITORY=sqlite
AI_GOVERNANCE_LEADERBOARD_SQLITE_PATH=./.ai-governance/governance.db
AI_GOVERNANCE_PROMPT_REPOSITORY=sqlite
AI_GOVERNANCE_PROMPT_SQLITE_PATH=./.ai-governance/governance.db
AI_GOVERNANCE_MODEL_REPOSITORY=sqlite
AI_GOVERNANCE_MODEL_SQLITE_PATH=./.ai-governance/governance.db
AI_GOVERNANCE_DATASET_REPOSITORY=sqlite
AI_GOVERNANCE_DATASET_SQLITE_PATH=./.ai-governance/governance.db
AI_GOVERNANCE_JOB_REPOSITORY=sqlite
AI_GOVERNANCE_JOB_SQLITE_PATH=./.ai-governance/governance.db
AI_GOVERNANCE_REPLAY_REPOSITORY=sqlite
AI_GOVERNANCE_REPLAY_SQLITE_PATH=./.ai-governance/governance.db
AI_GOVERNANCE_GOVERNANCE_DECISION_REPOSITORY=sqlite
AI_GOVERNANCE_GOVERNANCE_DECISION_SQLITE_PATH=./.ai-governance/governance.db
AI_GOVERNANCE_ONTOLOGY_SYNC_EVENT_REPOSITORY=sqlite
AI_GOVERNANCE_ONTOLOGY_SYNC_EVENT_SQLITE_PATH=./.ai-governance/governance.db
AI_GOVERNANCE_REPLAY_EXECUTION_CATALOG_BACKEND=sqlite
AI_GOVERNANCE_REPLAY_EXECUTION_CATALOG_SQLITE_PATH=./.ai-governance/governance.db

# -----------------------------
# OPEN AI Configuration
# -----------------------------
OPENAI_API_KEY=
OPENAI_DEFAULT_JUDGE_MODEL=gpt-4o-mini

# -----------------------------
# MCP Configurations
# ----------------------------
AI_GOVERNANCE_MCP_DRY_RUN_DEFAULT=False
AI_GOVERNANCE_MCP_HOST=127.0.0.1
AI_GOVERNANCE_MCP_PORT=8001
AI_GOVERNANCE_MCP_URL=http://127.0.0.1:8001
AI_GOVERNANCE_MCP_CLIENT_ID='ai-governance-mcp'
AI_GOVERNANCE_MCP_CLIENT_SECRET='mcp-secret'
AI_GOVERNANCE_MCP_TOKEN_URL=http://keycloak.localhost:18080/realms/ai-governance/protocol/openid-connect/token
AI_GOVERNANCE_MCP_AUDIT_DATABASE_PATH=./mcp_execution_audit.db

# Native MCP Streamable HTTP
AI_GOVERNANCE_MCP_TRANSPORT=streamable-http
AI_GOVERNANCE_MCP_HTTP_HOST=127.0.0.1
AI_GOVERNANCE_MCP_HTTP_PORT=8002
AI_GOVERNANCE_MCP_HTTP_PATH=/mcp
AI_GOVERNANCE_MCP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1
AI_GOVERNANCE_MCP_HTTP_ALLOWED_ORIGINS=http://localhost:6274,http://127.0.0.1:6274
AI_GOVERNANCE_MCP_HTTP_STATELESS=true
AI_GOVERNANCE_MCP_HTTP_JSON_RESPONSE=true
