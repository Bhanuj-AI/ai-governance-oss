# -----------------------------
# Kavach Configuration
# -----------------------------
KAVACH_ENV=local
KAVACH_CORS_ALLOW_ORIGINS='http://localhost:3000,http://127.0.0.1:3000'
KAVACH_AUTO_SEED_DEMO_DATA=true
KAVACH_API_LOG_LEVEL=debug
KAVACH_API_HOST=localhost
KAVACH_API_PORT=8000

# -----------------------------
# IDP Configuration
# -----------------------------
KAVACH_AUTH_MODE=keycloak # development
KAVACH_DEVELOPMENT_ACTOR_ID=local-admin
KAVACH_DEVELOPMENT_ACTOR_NAME=Local Administrator
KAVACH_OIDC_ISSUER=http://keycloak.localhost:18080/realms/kavach
KAVACH_OIDC_JWKS_REFRESH_SECONDS=300

# -----------------------------
# RBAC & Multi-Tenant Configuration
# -----------------------------
KAVACH_ALLOW_DEVELOPMENT_IDENTITY_IN_PRODUCTION=false
KAVACH_TENANCY_ENABLED=true

KAVACH_BOOTSTRAP_ORGANIZATION_ID=org_default
KAVACH_BOOTSTRAP_ORGANIZATION_NAME='Default Organization'
KAVACH_BOOTSTRAP_ORGANIZATION_SLUG=default
KAVACH_BOOTSTRAP_PROJECT_ID=project_default
KAVACH_BOOTSTRAP_PROJECT_NAME='Default Project'
KAVACH_BOOTSTRAP_PROJECT_SLUG=default

# -----------------------------
# Grpah DB Configuration
# -----------------------------
KAVACH_GRAPH_URI=bolt://neo4j:7687
KAVACH_GRAPH_USER=neo4j
KAVACH_GRAPH_PASSWORD=kavach-local-password
KAVACH_ONTOLOGY_REPOSITORY=neo4j

# -----------------------------
# Repositories Configuration
# -----------------------------
# inmemory / sqlite / postgres
KAVACH_TENANCY_REPOSITORY=sqlite
KAVACH_TENANCY_SQLITE_PATH=/var/lib/kavach/kavach.db
KAVACH_SETTINGS_REPOSITORY=sqlite
KAVACH_SETTINGS_SQLITE_PATH=/var/lib/kavach/kavach.db
KAVACH_POLICY_REPOSITORY=sqlite
KAVACH_POLICY_SQLITE_PATH=/var/lib/kavach/kavach.db
KAVACH_EVALUATION_REPOSITORY=sqlite
KAVACH_EVALUATION_SQLITE_PATH=/var/lib/kavach/kavach.db
KAVACH_EXPERIMENT_REPOSITORY=sqlite
KAVACH_EXPERIMENT_SQLITE_PATH=/var/lib/kavach/kavach.db
KAVACH_EXPERIMENT_CANDIDATE_REPOSITORY=sqlite
KAVACH_EXPERIMENT_CANDIDATE_SQLITE_PATH=/var/lib/kavach/kavach.db
KAVACH_EVALUATION_RUN_REPOSITORY=sqlite
KAVACH_EVALUATION_RUN_SQLITE_PATH=/var/lib/kavach/kavach.db
KAVACH_LEADERBOARD_REPOSITORY=sqlite
KAVACH_LEADERBOARD_SQLITE_PATH=/var/lib/kavach/kavach.db
KAVACH_PROMPT_REPOSITORY=sqlite
KAVACH_PROMPT_SQLITE_PATH=/var/lib/kavach/kavach.db
KAVACH_MODEL_REPOSITORY=sqlite
KAVACH_MODEL_SQLITE_PATH=/var/lib/kavach/kavach.db
KAVACH_DATASET_REPOSITORY=sqlite
KAVACH_DATASET_SQLITE_PATH=/var/lib/kavach/kavach.db
KAVACH_JOB_REPOSITORY=sqlite
KAVACH_JOB_SQLITE_PATH=/var/lib/kavach/kavach.db
KAVACH_REPLAY_REPOSITORY=sqlite
KAVACH_REPLAY_SQLITE_PATH=/var/lib/kavach/kavach.db
KAVACH_GOVERNANCE_DECISION_REPOSITORY=sqlite
KAVACH_GOVERNANCE_DECISION_SQLITE_PATH=/var/lib/kavach/kavach.db
KAVACH_ONTOLOGY_SYNC_EVENT_REPOSITORY=sqlite
KAVACH_ONTOLOGY_SYNC_EVENT_SQLITE_PATH=/var/lib/kavach/kavach.db
KAVACH_REPLAY_EXECUTION_CATALOG_BACKEND=sqlite
KAVACH_REPLAY_EXECUTION_CATALOG_SQLITE_PATH=/var/lib/kavach/kavach.db

# -----------------------------
# OPEN AI Configuration
# -----------------------------
OPENAI_API_KEY=
OPENAI_DEFAULT_JUDGE_MODEL=gpt-4o-mini

# -----------------------------
# MCP Configurations
# ----------------------------
KAVACH_MCP_DRY_RUN_DEFAULT=False
KAVACH_MCP_HOST=127.0.0.1
KAVACH_MCP_PORT=8001
KAVACH_MCP_URL=http://127.0.0.1:8001
KAVACH_MCP_CLIENT_ID='kavach-mcp'
KAVACH_MCP_CLIENT_SECRET='mcp-secret'
KAVACH_MCP_TOKEN_URL=http://keycloak.localhost:18080/realms/kavach/protocol/openid-connect/token
KAVACH_MCP_AUDIT_DATABASE_PATH=./mcp_execution_audit.db

# Native MCP Streamable HTTP
KAVACH_MCP_TRANSPORT=streamable-http
KAVACH_MCP_HTTP_HOST=127.0.0.1
KAVACH_MCP_HTTP_PORT=8002
KAVACH_MCP_HTTP_PATH=/mcp
KAVACH_MCP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1
KAVACH_MCP_HTTP_ALLOWED_ORIGINS=http://localhost:6274,http://127.0.0.1:6274
KAVACH_MCP_HTTP_STATELESS=true
KAVACH_MCP_HTTP_JSON_RESPONSE=true

# -----------------------------
# Extras
# -----------------------------
MODEL_REGISTRY_URL=
