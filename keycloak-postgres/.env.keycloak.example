# Development-only local Keycloak and PostgreSQL configuration.
# Copy this file to .env.keycloak before running ./servers.sh.
# Change these values on shared machines. Never use them in production.

POSTGRES_DB=ai-governance
POSTGRES_USER=ai-governance
POSTGRES_PASSWORD=local-postgres-password

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin-password
KEYCLOAK_URL=http://keycloak.localhost:18080
KEYCLOAK_HTTP_PORT=18080
KEYCLOAK_MANAGEMENT_PORT=19000
KEYCLOAK_PROXY_HEADERS=xforwarded

# Sign in to Studio as "studio" with this password.
AI_GOVERNANCE_STUDIO_PASSWORD=local-studio-password

# Development-only client credentials used by local AI Governance Control Plane services.
AI_GOVERNANCE_SERVICE_CLIENT_SECRET=local-service-client-secret
AI_GOVERNANCE_MCP_CLIENT_SECRET=local-mcp-client-secret
AI_GOVERNANCE_WALKTHROUGH_CLIENT_SECRET=local-walkthrough-client-secret
SYNTHETIC_RUNTIME_CLIENT_SECRET=local-synthetic-runtime-client-secret
