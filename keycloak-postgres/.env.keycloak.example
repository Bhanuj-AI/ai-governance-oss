# Development-only local Keycloak and PostgreSQL configuration.
# Copy this file to .env.keycloak before running ./kavach.sh.
# Change these values on shared machines. Never use them in production.

POSTGRES_DB=kavach
POSTGRES_USER=kavach
POSTGRES_PASSWORD=local-postgres-password

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin-password
KEYCLOAK_URL=http://keycloak.localhost:18080
KEYCLOAK_HTTP_PORT=18080
KEYCLOAK_MANAGEMENT_PORT=19000
KEYCLOAK_PROXY_HEADERS=xforwarded

# Sign in to Studio as "studio" with this password.
KAVACH_STUDIO_PASSWORD=local-studio-password

# Development-only client credentials used by local Kavach services.
KAVACH_SERVICE_CLIENT_SECRET=local-service-client-secret
KAVACH_MCP_CLIENT_SECRET=local-mcp-client-secret
KAVACH_WALKTHROUGH_CLIENT_SECRET=local-walkthrough-client-secret
