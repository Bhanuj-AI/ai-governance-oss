{
  "realm": "kavach",
  "enabled": true,
  "displayName": "Kavach",

  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,


  "roles": {
    "realm": [
      {
        "name": "kavach-access",
        "description": "Kavach Platform Access Role"
      },
      {
        "name": "kavach-service",
        "description": "Kavach Service Role"
      }
    ]
  },

  "clientScopes": [
    {
      "name": "basic",
      "description": "Standard OpenID Connect subject claim",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "true"
          }
        }
      ]
    },
    {
      "name": "kavach-context",
      "description": "Kavach Organization & Project Context",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "organization-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "organization_id",
            "claim.name": "organization_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "project-ids",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "project_ids",
            "claim.name": "project_ids",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "true"
          }
        }
      ]
    }
  ],

  "clients": [
    {
      "clientId": "kavach-studio",
      "name": "Kavach Studio",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",

      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,

      "redirectUris": [
          "http://localhost:3000/*"
      ],
      "webOrigins": [
          "http://localhost:3000"
      ],

      "defaultClientScopes": [
          "basic",
          "profile",
          "email",
          "roles",
          "kavach-context"
      ],

      "attributes": {
          "pkce.code.challenge.method": "S256",
          "use.lightweight.access.token": "false",
          "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "kavach-api",
      "name": "Kavach API",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "protocol": "openid-connect",

      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "kavach-mcp",
      "name": "Kavach MCP",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KAVACH_MCP_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
          {
            "name": "organization-id",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-hardcoded-claim-mapper",
            "consentRequired": false,
            "config": {
              "claim.name": "organization_id",
              "claim.value": "org_default",
              "jsonType.label": "String",
              "access.token.claim": "true",
              "id.token.claim": "false",
              "userinfo.token.claim": "false"
            }
          },
          {
            "name": "project-ids",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-hardcoded-claim-mapper",
            "consentRequired": false,
            "config": {
              "claim.name": "project_ids",
              "claim.value": "project_default",
              "jsonType.label": "String",
              "access.token.claim": "true",
              "id.token.claim": "false",
              "userinfo.token.claim": "false"
            }
          },
          {
            "name": "principal-type",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-hardcoded-claim-mapper",
            "consentRequired": false,
            "config": {
              "claim.name": "principal_type",
              "claim.value": "service",
              "jsonType.label": "String",
              "access.token.claim": "true",
              "id.token.claim": "false",
              "userinfo.token.claim": "false"
            }
          }
      ]
    },
    {
      "clientId": "kavach-walkthrough",
      "name": "Kavach Walkthrough",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KAVACH_WALKTHROUGH_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "organization-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "organization_id",
            "claim.value": "org_default",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "project-ids",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "project_ids",
            "claim.value": "project_default",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "principal-type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "principal_type",
            "claim.value": "service",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "kavach-service",
      "name": "Kavach Service",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KAVACH_SERVICE_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",

      "protocolMappers": [
        {
          "name": "organization-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
              "claim.name": "organization_id",
              "claim.value": "org_default",
              "jsonType.label": "String",
              "access.token.claim": "true",
              "id.token.claim": "false",
              "userinfo.token.claim": "false"
          }
        },
        {
          "name": "service-type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
              "claim.name": "principal_type",
              "claim.value": "service",
              "jsonType.label": "String",
              "access.token.claim": "true",
              "id.token.claim": "false",
              "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "kavach-mcp-vscode",
      "name": "Kavach MCP VSCode Client",
      "enabled": true,
      "publicClient": true,
      "clientAuthenticatorType": "none",

      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,

      "protocol": "openid-connect",

      "attributes": {
        "pkce.code.challenge.method": "S256",
        "use.lightweight.access.token": "false"
      },

      "redirectUris": [
        "http://127.0.0.1:*",
        "http://localhost:*",
        "https://oauth.pstmn.io/v1/callback"
      ],
      "webOrigins": [],
      "bearerOnly": false,

      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "kavach-context"
      ],

      "protocolMappers": [
        {
            "name": "subject",
            "protocol": "openid-connect",
            "protocolMapper": "oidc-sub-mapper",
            "consentRequired": false,
            "config": {
              "access.token.claim": "true",
              "id.token.claim": "true",
