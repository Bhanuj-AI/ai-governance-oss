FROM docker.io/astral/uv:python3.12-bookworm-slim

WORKDIR /workspace

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/ai-governance-venv

# psutil 5.9.8 has no compatible wheel for every Python/ARM combination,
# so retain the native build toolchain required by transitive dependencies.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        python3-dev && \
    rm -rf /var/lib/apt/lists/*

# Install locked dependencies first so this layer remains cacheable.  The lock
# includes an editable local plugin package, so its source must be present when
# uv resolves the installation plan.
COPY pyproject.toml uv.lock ./
COPY packages/bhanuj-governance-plugin-api/ packages/bhanuj-governance-plugin-api/
RUN uv sync --frozen --extra inspect --no-install-project

COPY . .
RUN uv sync --frozen --extra inspect

RUN chmod +x *.sh scripts/build/*.sh scripts/docker/*.sh scripts/keycloak/*.sh scripts/mcp/*.sh

EXPOSE 8000

CMD ["/opt/ai-governance-venv/bin/uvicorn", "ai_governance.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
